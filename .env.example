# llm-nexus 환경 변수 샘플
# 사용법: 이 파일을 .env 로 복사 후 값 채워서 사용

# ── LLM (llama-server, OpenAI 호환 API) ─────────────────────────
# llama-server 가 떠 있는 베이스 URL. 끝에 /v1 까지 포함.
LLAMA_BASE_URL=http://localhost:11434/v1

# llama-server 가 노출하는 모델 ID. /v1/models 로 확인.
LLAMA_MODEL=gemma-4-e4b-it-UD-Q4_K_XL.gguf

# ── Database (PostgreSQL, docker compose 로 기동) ───────────────
# 자격증명을 바꾸려면 docker-compose.yml 의 POSTGRES_* 도 같이 수정.
DATABASE_URL=postgresql+asyncpg://gemma:gemma@localhost:5432/gemma

# ── Agent ───────────────────────────────────────────────────────
# 에이전트의 파일 R/W 샌드박스. 상대경로면 프로젝트 루트 기준으로 해석됨.
WORKSPACE_DIR=./workspace

# ── 인증 (JWT) ──────────────────────────────────────────────────
# 반드시 무작위 문자열로 교체. 예: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production
# 토큰 유효시간 (분). 기본 7일.
JWT_EXPIRE_MINUTES=10080

# ── Obsidian Local REST API (옵션) ──────────────────────────────
# Obsidian "Local REST API" 플러그인이 발급한 API 키. 미사용 시 빈 값.
OBSIDIAN_API_KEY=
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27124

# ── Frontend (Next.js) ──────────────────────────────────────────
# 백엔드 주소를 덮어쓸 때만 설정. 기본값 = http://127.0.0.1:8000
# frontend/.env.local 에 두는 게 더 일반적이지만 여기에 둬도 OK.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
